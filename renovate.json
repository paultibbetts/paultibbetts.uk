{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "configMigration": true,
  "rangeStrategy": "replace",
  "schedule": [
    "after 10pm every weekday",
    "* * * * 0,6",
    "before 5am every weekday"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "minimumReleaseAge": "3 days",
      "groupName": "npm dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Keep the Volta and Docker Node.js runtimes aligned",
      "matchDatasources": ["docker", "node-version"],
      "matchPackageNames": ["node"],
      "groupName": "Node.js runtime"
    },
    {
      "description": "Keep every Hugo build aligned",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["gohugoio/hugo"],
      "groupName": "Hugo"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.(?:github|gitea)/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": ["HUGO_VERSION:\\s*(?<currentValue>\\S+)"],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG HUGO_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
